{
  "manifest_version": 2,
  "name": "Claude for Zen",
  "version": "1.3.0",
  "description": "Lets Claude Code switch Zen's remote control (WebDriver BiDi) on while it works and off when it is done, so Zen never has to be restarted. Part of claude-for-zen.",
  "homepage_url": "https://github.com/ilhamnadhif/claude-for-zen",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-for-zen@ilhamnadhif.github.io",
      "strict_min_version": "128.0"
    }
  },
  "experiment_apis": {
    "claudeForZen": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "parent.js",
        "events": ["startup"],
        "paths": [["claudeForZen"]]
      }
    }
  }
}
